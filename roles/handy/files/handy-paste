#!/bin/sh
# Handy pastes with Ctrl + the physical V key, which types "." on the bépo layout.
# Send Ctrl + the key that types "v" on bépo instead (evdev KEY_U), so apps get a real Ctrl+V.
set -e

# Keep the current clipboard (first type only) to restore it after pasting
saved=$(mktemp)
type=$(wl-paste --list-types 2>/dev/null | head -n 1) || true
if [ -n "$type" ]; then
    wl-paste --no-newline --type "$type" > "$saved"
fi

printf '%s' "$1" | wl-copy
sleep 0.1
ydotool key 29:1 22:1 22:0 29:0

# Restore once the app has read the pasted text, in background so Handy does not wait
(
    sleep 1
    if [ -n "$type" ]; then
        wl-copy --type "$type" < "$saved"
    else
        wl-copy --clear
    fi
    rm -f "$saved"
) >/dev/null 2>&1 &
